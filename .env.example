# Supabase (clave pública)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Consulta del reglamento (RAG)
ANTHROPIC_API_KEY=            # necesaria para los modos «experto» y «breve»
# ANTHROPIC_WORKSPACE_ID=      # solo si la clave no está asociada a un workspace (ID tipo wrkspc_...)
VOYAGE_API_KEY=               # opcional: embeddings multilingües (búsqueda híbrida). Sin ella, solo BM25
# VOYAGE_MODEL=voyage-4
# REGLAMENTO_MODEL=claude-opus-5-5          # modelo que responde (p. ej. claude-sonnet-5-5 para ahorrar)
# REGLAMENTO_REWRITE_MODEL=claude-haiku-4-5 # modelo que traduce la pregunta a inglés técnico
# REGLAMENTO_ACCESS_CODE=       # si se define, la API exige este código (cabecera x-access-code); sin él, la ruta queda abierta. Debe ser ASCII y sin espacios al principio/final
# REGLAMENTO_REQUIRE_ACCESS_CODE=false # si es 'true' y no hay REGLAMENTO_ACCESS_CODE, la ruta responde 503 en vez de abrirse
# REGLAMENTO_TRUSTED_PROXY_HOPS=0 # proxies de confianza delante de la app. 0 = se ignora x-forwarded-for (cupo compartido); N = IP a N saltos desde la derecha
# REGLAMENTO_MAX_CONCURRENT=3   # consultas con IA simultáneas
# REGLAMENTO_HOURLY_LIMIT=20    # consultas con IA por cliente y hora
# REGLAMENTO_DAILY_LIMIT=300    # consultas con IA al día en total
# REGLAMENTO_DATA_DIR=          # carpeta del índice (por defecto ./data/regulation); en Docker se monta en /app/data
# VOYAGE_PACE_MS=               # solo para `npm run reglamento:index`: pausa entre lotes de embeddings
